{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build-only",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://eventpass-api-xl0y.onrender.com/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://eventpass-api-xl0y.onrender.com/sanctum/:path*" },
    { "source": "/auth/google/:path*", "destination": "https://eventpass-api-xl0y.onrender.com/auth/google/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

# Copy to .env next to docker-compose.yml. Everything here is optional:
# without keys the app uses the built-in test payment gateway.

# fake,liqpay,stripe
PAYMENT_GATEWAYS=fake

# Public URL that LiqPay can reach (e.g. https://abc123.ngrok-free.app)
WEBHOOK_BASE_URL=http://localhost:8000

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

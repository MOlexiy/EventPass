APP_NAME=EventPass
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Docker compose overrides these with PostgreSQL; SQLite works for a quick local run.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=eventpass
# DB_USERNAME=eventpass
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Requests from these hosts get cookie (session) auth via Sanctum.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost

QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit in Docker (UI at http://localhost:8025); "log" writes emails to storage/logs.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="tickets@eventpass.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Payments ------------------------------------------------------------
# Comma-separated: fake,liqpay,stripe. "fake" needs no keys.
PAYMENT_GATEWAYS=fake
ORDER_HOLD_MINUTES=15
# Public URL providers post webhooks to (e.g. an ngrok tunnel to :8000).
WEBHOOK_BASE_URL="${APP_URL}"

# https://www.liqpay.ua/en/adminbusiness -> API keys (sandbox keys start with sandbox_)
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

# https://dashboard.stripe.com/test/apikeys ; webhook secret from `stripe listen`
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Google sign-in (optional) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${FRONTEND_URL}/auth/google/callback"
